# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
# Server-only. Configure in Vercel and local deployment tooling; never expose with VITE_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Google Script Web App URL (Legacy Fallback)
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/your_deployment_id/exec"

# Handbook video integration
# Set a shared CDN/storage folder containing section videos such as
# part-01-section-01.mp4. If a section-specific file is unavailable, the portal
# falls back to the matching part-level URL or override where possible.
VITE_HANDBOOK_VIDEO_BASE_URL=""
# Optional per-Part overrides. You can use direct MP4 URLs or YouTube/Vimeo embed URLs.
VITE_HANDBOOK_VIDEO_PART_1=""
VITE_HANDBOOK_VIDEO_PART_2=""
VITE_HANDBOOK_VIDEO_PART_3=""
VITE_HANDBOOK_VIDEO_PART_4=""
VITE_HANDBOOK_VIDEO_PART_5=""
VITE_HANDBOOK_VIDEO_PART_6=""
VITE_HANDBOOK_VIDEO_PART_7=""
VITE_HANDBOOK_VIDEO_PART_8=""
VITE_HANDBOOK_VIDEO_PART_9=""
VITE_HANDBOOK_VIDEO_PART_10=""
VITE_HANDBOOK_VIDEO_PART_11=""
VITE_HANDBOOK_VIDEO_PART_12=""
VITE_HANDBOOK_VIDEO_PART_13=""
VITE_HANDBOOK_VIDEO_PART_14=""
VITE_HANDBOOK_VIDEO_PART_15=""
# Optional per-section overrides.
# Example:
# VITE_HANDBOOK_VIDEO_PART_1_SECTION_1="https://cdn.example.com/handbook/part-01-section-01.mp4"
# VITE_HANDBOOK_VIDEO_PART_1_SECTION_1_TITLE="Welcome Message"
# VITE_HANDBOOK_VIDEO_PART_1_SECTION_1_DURATION="2:45"
# VITE_HANDBOOK_VIDEO_PART_1_SECTION_1_POSTER_URL="https://cdn.example.com/handbook/part-01-section-01.jpg"
